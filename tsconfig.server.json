{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["node"],
		"paths": { "$lib/*": ["./src/lib/*"] }
	},
	"include": ["server/**/*.ts", "tests/server/**/*.ts"]
}

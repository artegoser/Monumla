{
	"name": "monumla",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "pnpm db:generate && pnpm wasm:server && pnpm wasm:build && vite dev",
		"build": "pnpm db:generate && pnpm wasm:server && pnpm wasm:build && node scripts/source-archive.mjs && vite build",
		"preview": "vite preview",
		"check": "NODE_ENV=development pnpm wasm:build && NODE_ENV=development svelte-kit sync && NODE_ENV=development svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "NODE_ENV=development pnpm wasm:build && NODE_ENV=development svelte-kit sync && NODE_ENV=development svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"db:push": "prisma db push",
		"db:migrate": "prisma migrate deploy",
		"db:studio": "prisma studio",
		"rust:fmt": "cargo fmt --all --check",
		"rust:lint": "cargo clippy --workspace --all-targets --all-features",
		"rust:test": "cargo test --workspace",
		"rust:check": "cargo check --workspace",
		"wasm:build": "wasm-pack build crates/monumla-wasm --target web --out-dir ../../src/lib/wasm/pkg --out-name monumla",
		"test": "cargo test --workspace && pnpm check",
		"test:full": "pnpm test:server && cargo test --workspace && cargo test --release -p monumla-games-chess perft::tests:: -- --ignored && cargo clippy --workspace --all-targets --all-features && pnpm check && pnpm build",
		"browserslist:update": "pnpm dlx update-browserslist-db latest",
		"start": "tsx --tsconfig tsconfig.server.json server.mjs",
		"test:browser": "pnpm build && playwright test",
		"db:generate": "prisma generate",
		"db:dev": "prisma migrate dev",
		"wasm:server": "node scripts/build-server-wasm.mjs",
		"test:server": "tsx --test --test-concurrency=1 tests/server/*.test.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.3",
		"@eslint/js": "^9.39.5",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.9.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@types/node": "^26.6.6",
		"@types/ws": "^8.18.2",
		"autoprefixer": "^10.4.20",
		"eslint": "^9.7.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.36.0",
		"globals": "^15.0.0",
		"prettier": "^3.3.2",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^3.4.9",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.0.0",
		"vite": "^6.0.0"
	},
	"dependencies": {
		"@prisma/adapter-better-sqlite3": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/forms": "^0.5.9",
		"@tailwindcss/typography": "^0.5.15",
		"dotenv": "^18.0.9",
		"prisma": "^7.10.1",
		"tsx": "^4.23.15",
		"ws": "^8.21.3"
	},
	"license": "AGPL-3.0-only"
}
